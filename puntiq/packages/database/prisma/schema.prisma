// BRINLORE PUNTIQ — databaseschema (PostgreSQL 15+)
//
// Uitgangspunten
// - Multi-tenant: alle bedrijfsdata hangt aan een `Company`. Gebruikers krijgen toegang via `Membership`.
// - Primaire sleutels zijn UUID v7 (tijd-geordend, dus vriendelijk voor B-tree-indexen).
// - Tijdstippen zijn `timestamptz(3)`, kalenderdata (looptijd, vervaldatum) zijn `date`.
// - Geldbedragen zijn `numeric(12,2)`; nooit float.
// - Tabellen en kolommen in snake_case; het Prisma-model blijft camelCase.
// - CHECK-, EXCLUDE- en partiële unieke constraints die Prisma niet kan uitdrukken staan in de
//   migratie (prisma/migrations/*_init/migration.sql, sectie "Aanvullende constraints").
// - Kernrelaties (woning ↔ gebouw, contract ↔ woning, contract ↔ huurder) gebruiken samengestelde
//   foreign keys op (company_id, id): een contract kan zo nooit naar een woning van een ander bedrijf wijzen.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

// =====================================================================
// Enums
// =====================================================================

enum PlatformRole {
  USER
  ADMIN

  @@map("platform_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  OWNER // volledige rechten, inclusief bedrijf verwijderen
  ADMIN // gebruikers en instellingen beheren
  MANAGER // dagelijks beheer: vastgoed, huurders, contracten, financiën
  VIEWER // alleen lezen

  @@map("membership_role")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM

  @@map("theme")
}

enum EmailFrequency {
  DAILY
  WEEKLY

  @@map("email_frequency")
}

enum BuildingType {
  APARTMENT_COMPLEX
  SINGLE_FAMILY
  MIXED_USE
  COMMERCIAL
  OTHER

  @@map("building_type")
}

enum HeritageStatus {
  NONE
  RIJKSMONUMENT
  GEMEENTELIJK_MONUMENT
  BESCHERMD_STADSGEZICHT

  @@map("heritage_status")
}

enum EnergyLabel {
  A4_PLUS // A++++
  A3_PLUS // A+++
  A2_PLUS // A++
  A1_PLUS // A+
  A
  B
  C
  D
  E
  F
  G
  NONE

  @@map("energy_label")
}

enum UnitType {
  APARTMENT
  SINGLE_FAMILY_HOUSE
  STUDIO
  ROOM // onzelfstandige woonruimte (WWSO)
  COMMERCIAL
  PARKING
  STORAGE
  OTHER

  @@map("unit_type")
}

enum UnitStatus {
  AVAILABLE
  RENTED
  UNDER_MAINTENANCE
  UNAVAILABLE

  @@map("unit_status")
}

enum RentalSegment {
  SOCIAL // sociale huur
  MIDDLE // middenhuur
  FREE // vrije sector

  @@map("rental_segment")
}

enum WwsScheme {
  WWS // zelfstandige woonruimte
  WWSO // onzelfstandige woonruimte

  @@map("wws_scheme")
}

enum TenantType {
  PERSON
  ORGANIZATION

  @@map("tenant_type")
}

enum TenantStatus {
  PROSPECT
  ACTIVE
  FORMER

  @@map("tenant_status")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  TERMINATED

  @@map("contract_status")
}

enum ContractType {
  FIXED_TERM // bepaalde tijd
  INDEFINITE // onbepaalde tijd

  @@map("contract_type")
}

enum RentChangeReason {
  INDEXATION
  AGREEMENT
  CORRECTION
  REDUCTION

  @@map("rent_change_reason")
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HEATING
  ROOF
  EXTERIOR
  INTERIOR
  APPLIANCES
  SAFETY
  OTHER

  @@map("maintenance_category")
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("maintenance_priority")
}

enum MaintenanceStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("maintenance_status")
}

enum DocumentCategory {
  CONTRACT
  WWS
  MAINTENANCE
  FINANCIAL
  IDENTITY
  PHOTO
  CORRESPONDENCE
  OTHER

  @@map("document_category")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("invoice_status")
}

enum InvoiceKind {
  RENT // periodieke huurfactuur
  DEPOSIT
  SERVICE_CHARGE_SETTLEMENT // jaarafrekening servicekosten
  MAINTENANCE // doorbelaste reparatie
  OTHER

  @@map("invoice_kind")
}

enum InvoiceLineType {
  RENT
  SERVICE_CHARGES
  DEPOSIT
  MAINTENANCE
  UTILITIES
  OTHER

  @@map("invoice_line_type")
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  IDEAL
  CASH
  OTHER

  @@map("payment_method")
}

enum ExpenseCategory {
  MAINTENANCE
  INSURANCE
  TAXES
  UTILITIES
  MANAGEMENT
  FINANCING
  OTHER

  @@map("expense_category")
}

enum NotificationType {
  CONTRACT_EXPIRING
  CONTRACT_EXPIRED
  RENT_INDEXATION
  MAINTENANCE_URGENT
  PAYMENT_DUE
  PAYMENT_OVERDUE
  SYSTEM

  @@map("notification_type")
}

// =====================================================================
// Bedrijven, gebruikers en toegang
// =====================================================================

model Company {
  id                     String   @id @default(uuid(7)) @db.Uuid
  name                   String   @db.VarChar(160)
  legalName              String?  @map("legal_name") @db.VarChar(200)
  kvkNumber              String?  @unique @map("kvk_number") @db.Char(8)
  vatNumber              String?  @map("vat_number") @db.VarChar(20)
  iban                   String?  @db.VarChar(34)
  email                  String?  @db.Citext
  phone                  String?  @db.VarChar(30)
  street                 String?  @db.VarChar(160)
  houseNumber            String?  @map("house_number") @db.VarChar(20)
  postcode               String?  @db.VarChar(10)
  city                   String?  @db.VarChar(100)
  country                String   @default("NL") @db.Char(2)
  logoKey                String?  @map("logo_key") @db.VarChar(300)
  defaultRentIndexation  Decimal  @default(3.5) @map("default_rent_indexation") @db.Decimal(5, 2)
  defaultPaymentTermDays Int      @default(14) @map("default_payment_term_days") @db.SmallInt
  invoicePrefix          String   @default("F") @map("invoice_prefix") @db.VarChar(10)
  nextInvoiceNumber      Int      @default(1) @map("next_invoice_number")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  invitations     Invitation[]
  buildings       Building[]
  units           Unit[]
  wwsCalculations WwsCalculation[]
  tenants         Tenant[]
  contracts       Contract[]
  rentChanges     RentChange[]
  contractors     Contractor[]
  maintenance     MaintenanceRequest[]
  documents       Document[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  activeFor       UserPreference[]

  @@index([name])
  @@map("companies")
}

model User {
  id              String       @id @default(uuid(7)) @db.Uuid
  email           String       @unique @db.Citext
  username        String       @unique @db.Citext
  passwordHash    String       @map("password_hash") @db.VarChar(255)
  platformRole    PlatformRole @default(USER) @map("platform_role")
  status          UserStatus   @default(ACTIVE)
  firstName       String?      @map("first_name") @db.VarChar(100)
  lastName        String?      @map("last_name") @db.VarChar(100)
  phone           String?      @db.VarChar(30)
  jobTitle        String?      @map("job_title") @db.VarChar(100)
  avatarKey       String?      @map("avatar_key") @db.VarChar(300)
  /// Ophogen maakt alle uitgegeven sessietokens in één keer ongeldig ("overal uitloggen").
  sessionVersion  Int          @default(1) @map("session_version")
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  preferences         UserPreference?
  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     Invitation[]         @relation("InvitedBy")
  wwsCalculations     WwsCalculation[]     @relation("WwsCreatedBy")
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceAssignee")
  reportedMaintenance MaintenanceRequest[] @relation("MaintenanceCreatedBy")
  uploadedDocuments   Document[]           @relation("DocumentUploadedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([status])
  @@map("users")
}

/// Persoonlijke voorkeuren (1-op-1 met User). Bedrijfsbrede standaarden staan op Company.
model UserPreference {
  userId               String         @id @map("user_id") @db.Uuid
  activeCompanyId      String?        @map("active_company_id") @db.Uuid
  theme                Theme          @default(LIGHT)
  compact              Boolean        @default(false)
  reducedMotion        Boolean        @default(false) @map("reduced_motion")
  landingPage          String         @default("dashboard") @map("landing_page") @db.VarChar(30)
  notifyContracts      Boolean        @default(true) @map("notify_contracts")
  notifyIndexation     Boolean        @default(true) @map("notify_indexation")
  notifyMaintenance    Boolean        @default(true) @map("notify_maintenance")
  notifyPayments       Boolean        @default(true) @map("notify_payments")
  contractReminderDays Int            @default(90) @map("contract_reminder_days") @db.SmallInt
  paymentReminderDays  Int            @default(7) @map("payment_reminder_days") @db.SmallInt
  emailNotifications   Boolean        @default(true) @map("email_notifications")
  emailFrequency       EmailFrequency @default(WEEKLY) @map("email_frequency")
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([activeCompanyId])
  @@map("user_preferences")
}

model Membership {
  id        String         @id @default(uuid(7)) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole @default(MANAGER)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_memberships")
}

model Invitation {
  id          String         @id @default(uuid(7)) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  email       String         @db.Citext
  role        MembershipRole @default(MANAGER)
  /// SHA-256 van het uitnodigingstoken; het token zelf wordt nooit opgeslagen.
  tokenHash   String         @unique @map("token_hash") @db.Char(64)
  invitedById String?        @map("invited_by_id") @db.Uuid
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([email])
  @@map("company_invitations")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(400)
  ipAddress  String?   @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =====================================================================
// Vastgoed: gebouwen, woningen, WWS
// =====================================================================

/// Gebouw of complex. Een eengezinswoning is een gebouw met één woning.
model Building {
  id                 String         @id @default(uuid(7)) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  name               String         @db.VarChar(160)
  buildingType       BuildingType   @default(APARTMENT_COMPLEX) @map("building_type")
  street             String         @db.VarChar(160)
  houseNumber        String?        @map("house_number") @db.VarChar(20)
  postcode           String         @db.VarChar(10)
  city               String         @db.VarChar(100)
  country            String         @default("NL") @db.Char(2)
  yearBuilt          Int?           @map("year_built") @db.SmallInt
  energyLabel        EnergyLabel?   @map("energy_label")
  heritageStatus     HeritageStatus @default(NONE) @map("heritage_status")
  cadastralReference String?        @map("cadastral_reference") @db.VarChar(40)
  notes              String?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  units       Unit[]
  maintenance MaintenanceRequest[]
  documents   Document[]
  expenses    Expense[]

  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, city])
  @@map("buildings")
}

/// Woning / verhuureenheid.
model Unit {
  id                  String         @id @default(uuid(7)) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  buildingId          String         @map("building_id") @db.Uuid
  name                String         @db.VarChar(160)
  unitType            UnitType       @default(APARTMENT) @map("unit_type")
  status              UnitStatus     @default(AVAILABLE)
  street              String         @db.VarChar(160)
  houseNumber         Int            @map("house_number")
  /// Lege string i.p.v. NULL, zodat de unieke adresindex ook zonder toevoeging werkt.
  houseNumberAddition String         @default("") @map("house_number_addition") @db.VarChar(10)
  postcode            String         @db.VarChar(10)
  city                String         @db.VarChar(100)
  floor               String?        @db.VarChar(20)
  livingArea          Decimal?       @map("living_area") @db.Decimal(8, 2)
  rooms               Int?           @db.SmallInt
  bedrooms            Int?           @db.SmallInt
  yearBuilt           Int?           @map("year_built") @db.SmallInt
  energyLabel         EnergyLabel?   @map("energy_label")
  wozValue            Decimal?       @map("woz_value") @db.Decimal(12, 2)
  wozReferenceDate    DateTime?      @map("woz_reference_date") @db.Date
  /// Gecachte uitkomst van de meest recente WWS-berekening.
  wwsPoints           Decimal?       @map("wws_points") @db.Decimal(7, 2)
  maxRent             Decimal?       @map("max_rent") @db.Decimal(10, 2)
  rentalSegment       RentalSegment? @map("rental_segment")
  askingRent          Decimal?       @map("asking_rent") @db.Decimal(10, 2)
  salePrice           Decimal?       @map("sale_price") @db.Decimal(12, 2)
  description         String?
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building        Building             @relation(fields: [companyId, buildingId], references: [companyId, id], onDelete: NoAction)
  photos          UnitPhoto[]
  wwsCalculations WwsCalculation[]
  contracts       Contract[]
  maintenance     MaintenanceRequest[]
  documents       Document[]
  expenses        Expense[]

  @@unique([companyId, id])
  @@unique([companyId, postcode, houseNumber, houseNumberAddition])
  @@index([companyId, status])
  @@index([companyId, city])
  @@index([buildingId])
  @@map("units")
}

model UnitPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  storageKey String   @unique @map("storage_key") @db.VarChar(300)
  caption    String?  @db.VarChar(200)
  position   Int      @default(0) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, position])
  @@map("unit_photos")
}

/// Vastgelegde WWS/WWSO-puntentelling. Invoer en uitkomst worden integraal bewaard,
/// zodat een berekening later reproduceerbaar is, ook als de rekenregels wijzigen.
model WwsCalculation {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  unitId        String?       @map("unit_id") @db.Uuid
  createdById   String?       @map("created_by_id") @db.Uuid
  label         String        @db.VarChar(160)
  scheme        WwsScheme     @default(WWS)
  /// Peildatum: bepaalt welke puntentabel en huurgrenzen gelden.
  referenceDate DateTime      @map("reference_date") @db.Date
  rulesVersion  String        @map("rules_version") @db.VarChar(20)
  input         Json
  result        Json
  totalPoints   Decimal       @map("total_points") @db.Decimal(7, 2)
  maxRent       Decimal       @map("max_rent") @db.Decimal(10, 2)
  segment       RentalSegment
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit      Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("WwsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([unitId, referenceDate(sort: Desc)])
  @@map("wws_calculations")
}

// =====================================================================
// Huurders en contracten
// =====================================================================

model Tenant {
  id               String       @id @default(uuid(7)) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  tenantType       TenantType   @default(PERSON) @map("tenant_type")
  status           TenantStatus @default(PROSPECT)
  firstName        String?      @map("first_name") @db.VarChar(100)
  lastName         String?      @map("last_name") @db.VarChar(100)
  organizationName String?      @map("organization_name") @db.VarChar(200)
  /// Naam zoals getoond en gesorteerd; door de applicatie afgeleid uit de velden hierboven.
  displayName      String       @map("display_name") @db.VarChar(200)
  email            String?      @db.Citext
  phone            String?      @db.VarChar(30)
  dateOfBirth      DateTime?    @map("date_of_birth") @db.Date
  kvkNumber        String?      @map("kvk_number") @db.Char(8)
  iban             String?      @db.VarChar(34)
  /// Correspondentieadres, alleen als dat afwijkt van de gehuurde woning.
  mailingAddress   String?      @map("mailing_address") @db.VarChar(300)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts   ContractTenant[]
  maintenance MaintenanceRequest[]
  documents   Document[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([companyId, id])
  @@index([companyId, status])
  @@index([companyId, displayName])
  @@index([companyId, email])
  @@map("tenants")
}

model Contract {
  id                   String         @id @default(uuid(7)) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  unitId               String         @map("unit_id") @db.Uuid
  contractNumber       String         @map("contract_number") @db.VarChar(40)
  status               ContractStatus @default(DRAFT)
  contractType         ContractType   @default(INDEFINITE) @map("contract_type")
  startDate            DateTime       @map("start_date") @db.Date
  /// NULL bij onbepaalde tijd.
  endDate              DateTime?      @map("end_date") @db.Date
  noticePeriodMonths   Int?           @map("notice_period_months") @db.SmallInt
  baseRent             Decimal        @map("base_rent") @db.Decimal(10, 2)
  serviceCharges       Decimal        @default(0) @map("service_charges") @db.Decimal(10, 2)
  depositAmount        Decimal        @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  paymentDayOfMonth    Int            @default(1) @map("payment_day_of_month") @db.SmallInt
  indexationPercentage Decimal?       @map("indexation_percentage") @db.Decimal(5, 2)
  nextIndexationDate   DateTime?      @map("next_indexation_date") @db.Date
  signedAt             DateTime?      @map("signed_at") @db.Timestamptz(3)
  terminatedAt         DateTime?      @map("terminated_at") @db.Timestamptz(3)
  terminationReason    String?        @map("termination_reason") @db.VarChar(300)
  notes                String?
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit        Unit             @relation(fields: [companyId, unitId], references: [companyId, id], onDelete: NoAction)
  tenants     ContractTenant[]
  rentChanges RentChange[]
  documents   Document[]
  invoices    Invoice[]

  @@unique([companyId, id])
  @@unique([companyId, contractNumber])
  @@index([companyId, status])
  @@index([companyId, endDate])
  @@index([companyId, nextIndexationDate])
  @@index([unitId, startDate])
  @@map("contracts")
}

/// Koppeltabel: één contract kan meerdere huurders hebben (bijv. partners).
model ContractTenant {
  companyId  String   @map("company_id") @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [companyId, contractId], references: [companyId, id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [companyId, tenantId], references: [companyId, id], onDelete: NoAction)

  @@id([contractId, tenantId])
  @@index([companyId, tenantId])
  @@map("contract_tenants")
}

/// Historie van huurwijzigingen (indexatie, afspraak, correctie).
model RentChange {
  id            String           @id @default(uuid(7)) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  contractId    String           @map("contract_id") @db.Uuid
  reason        RentChangeReason
  effectiveDate DateTime         @map("effective_date") @db.Date
  previousRent  Decimal          @map("previous_rent") @db.Decimal(10, 2)
  newRent       Decimal          @map("new_rent") @db.Decimal(10, 2)
  percentage    Decimal?         @db.Decimal(5, 2)
  note          String?          @db.VarChar(300)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [companyId, contractId], references: [companyId, id], onDelete: Cascade)

  @@unique([contractId, effectiveDate])
  @@index([companyId, effectiveDate])
  @@map("rent_changes")
}

// =====================================================================
// Onderhoud
// =====================================================================

model Contractor {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(160)
  trade     String?  @db.VarChar(100)
  email     String?  @db.Citext
  phone     String?  @db.VarChar(30)
  kvkNumber String?  @map("kvk_number") @db.Char(8)
  iban      String?  @db.VarChar(34)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  maintenance MaintenanceRequest[]
  expenses    Expense[]

  @@index([companyId, name])
  @@map("contractors")
}

/// Onderhoudsverzoek op een woning of op een gebouw (gemeenschappelijke ruimte). Minstens één van beide is verplicht.
model MaintenanceRequest {
  id                 String              @id @default(uuid(7)) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  buildingId         String?             @map("building_id") @db.Uuid
  unitId             String?             @map("unit_id") @db.Uuid
  reportedByTenantId String?             @map("reported_by_tenant_id") @db.Uuid
  contractorId       String?             @map("contractor_id") @db.Uuid
  assignedToId       String?             @map("assigned_to_id") @db.Uuid
  createdById        String?             @map("created_by_id") @db.Uuid
  title              String              @db.VarChar(160)
  description        String?
  category           MaintenanceCategory @default(OTHER)
  priority           MaintenancePriority @default(MEDIUM)
  status             MaintenanceStatus   @default(OPEN)
  reportedAt         DateTime            @default(now()) @map("reported_at") @db.Timestamptz(3)
  scheduledFor       DateTime?           @map("scheduled_for") @db.Date
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  estimatedCost      Decimal?            @map("estimated_cost") @db.Decimal(12, 2)
  actualCost         Decimal?            @map("actual_cost") @db.Decimal(12, 2)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building         Building?   @relation(fields: [buildingId], references: [id], onDelete: NoAction)
  unit             Unit?       @relation(fields: [unitId], references: [id], onDelete: NoAction)
  reportedByTenant Tenant?     @relation(fields: [reportedByTenantId], references: [id], onDelete: SetNull)
  contractor       Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  assignedTo       User?       @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy        User?       @relation("MaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents        Document[]
  expenses         Expense[]

  @@index([companyId, status, priority])
  @@index([unitId])
  @@index([buildingId])
  @@index([contractorId])
  @@index([assignedToId])
  @@map("maintenance_requests")
}

// =====================================================================
// Documenten
// =====================================================================

/// Bestand in object storage (S3/Azure Blob); de database bewaart alleen metadata en koppelingen.
/// Een document kan aan meerdere entiteiten tegelijk hangen (bijv. contract én woning).
model Document {
  id                   String           @id @default(uuid(7)) @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  uploadedById         String?          @map("uploaded_by_id") @db.Uuid
  title                String           @db.VarChar(200)
  category             DocumentCategory @default(OTHER)
  fileName             String           @map("file_name") @db.VarChar(255)
  mimeType             String           @map("mime_type") @db.VarChar(100)
  sizeBytes            BigInt           @map("size_bytes")
  storageKey           String           @unique @map("storage_key") @db.VarChar(300)
  checksumSha256       String?          @map("checksum_sha256") @db.Char(64)
  documentDate         DateTime?        @map("document_date") @db.Date
  /// Bewaartermijn: na deze datum mag het document worden opgeschoond (AVG).
  retainUntil          DateTime?        @map("retain_until") @db.Date
  buildingId           String?          @map("building_id") @db.Uuid
  unitId               String?          @map("unit_id") @db.Uuid
  tenantId             String?          @map("tenant_id") @db.Uuid
  contractId           String?          @map("contract_id") @db.Uuid
  maintenanceRequestId String?          @map("maintenance_request_id") @db.Uuid
  invoiceId            String?          @map("invoice_id") @db.Uuid
  expenseId            String?          @map("expense_id") @db.Uuid
  wwsCalculationId     String?          @map("wws_calculation_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy         User?               @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  building           Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract           Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expense            Expense?            @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  wwsCalculation     WwsCalculation?     @relation(fields: [wwsCalculationId], references: [id], onDelete: SetNull)

  @@index([companyId, category])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([buildingId])
  @@index([unitId])
  @@index([tenantId])
  @@index([contractId])
  @@index([maintenanceRequestId])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([wwsCalculationId])
  @@index([retainUntil])
  @@map("documents")
}

// =====================================================================
// Financiën
// =====================================================================

/// Factuur / vordering aan een huurder. Status OVERDUE is afgeleid (open én vervaldatum verstreken).
model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  contractId    String?       @map("contract_id") @db.Uuid
  tenantId      String?       @map("tenant_id") @db.Uuid
  invoiceNumber String        @map("invoice_number") @db.VarChar(40)
  kind          InvoiceKind   @default(OTHER)
  status        InvoiceStatus @default(DRAFT)
  description   String?       @db.VarChar(300)
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  /// Huurperiode. Voor kind = RENT is (contract_id, period_start) uniek: dezelfde maand wordt nooit twee keer gefactureerd.
  periodStart   DateTime?     @map("period_start") @db.Date
  periodEnd     DateTime?     @map("period_end") @db.Date
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("EUR") @db.Char(3)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(3)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contract    Contract?           @relation(fields: [contractId], references: [id], onDelete: NoAction)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: NoAction)
  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  documents   Document[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status, dueDate])
  @@index([contractId, periodStart])
  @@index([tenantId])
  @@map("invoices")
}

model InvoiceLine {
  id          String          @id @default(uuid(7)) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  position    Int             @db.SmallInt
  lineType    InvoiceLineType @map("line_type")
  description String          @db.VarChar(200)
  quantity    Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  vatRate     Decimal         @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount      Decimal         @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

/// Ontvangen betaling. Wordt via PaymentAllocation over één of meer facturen verdeeld.
model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  tenantId          String?       @map("tenant_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  receivedOn        DateTime      @map("received_on") @db.Date
  method            PaymentMethod @default(BANK_TRANSFER)
  reference         String?       @db.VarChar(140)
  /// Transactie-id uit de bankkoppeling; voorkomt dubbele import.
  bankTransactionId String?       @map("bank_transaction_id") @db.VarChar(100)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@unique([companyId, bankTransactionId])
  @@index([companyId, receivedOn(sort: Desc)])
  @@index([tenantId])
  @@map("payments")
}

model PaymentAllocation {
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: NoAction)

  @@id([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Kosten aan de eigenaarskant (onderhoud, verzekering, belastingen…).
model Expense {
  id                   String          @id @default(uuid(7)) @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  buildingId           String?         @map("building_id") @db.Uuid
  unitId               String?         @map("unit_id") @db.Uuid
  contractorId         String?         @map("contractor_id") @db.Uuid
  maintenanceRequestId String?         @map("maintenance_request_id") @db.Uuid
  category             ExpenseCategory @default(OTHER)
  description          String          @db.VarChar(200)
  amount               Decimal         @db.Decimal(12, 2)
  vatAmount            Decimal         @default(0) @map("vat_amount") @db.Decimal(12, 2)
  incurredOn           DateTime        @map("incurred_on") @db.Date
  paidOn               DateTime?       @map("paid_on") @db.Date
  supplierReference    String?         @map("supplier_reference") @db.VarChar(100)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  building           Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  contractor         Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  maintenanceRequest MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  documents          Document[]

  @@index([companyId, incurredOn(sort: Desc)])
  @@index([companyId, category])
  @@index([buildingId])
  @@index([unitId])
  @@index([maintenanceRequestId])
  @@index([contractorId])
  @@map("expenses")
}

// =====================================================================
// Meldingen, audit en platform
// =====================================================================

model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  companyId  String?          @map("company_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String?          @db.VarChar(500)
  entityType String?          @map("entity_type") @db.VarChar(40)
  entityId   String?          @map("entity_id") @db.Uuid
  /// Bijv. "contract:<id>:expiring" — voorkomt dat dezelfde melding twee keer wordt aangemaakt.
  dedupeKey  String           @map("dedupe_key") @db.VarChar(200)
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only. Bedrijf en actor worden bij verwijdering losgekoppeld, de regel zelf blijft bestaan.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Naam van de actor op het moment van de actie.
  actorLabel String   @map("actor_label") @db.VarChar(120)
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Platformbrede instellingen (registratie open, onderhoudsmodus, mededeling) als sleutel/waarde.
model SiteSetting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}
